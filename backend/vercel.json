{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api?path=/"
    },
    {
      "source": "/healthz",
      "destination": "/api?path=/healthz"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api?path=/auth/:path*"
    },
    {
      "source": "/todos",
      "destination": "/api?path=/todos"
    },
    {
      "source": "/todos/:id",
      "destination": "/api?path=/todos/:id"
    }
  ]
}
